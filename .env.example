# Copy this file to .env, remove the leading "# " from the keys you use, and put your own values in.
# .env is ignored by git. The control room (python -m karamaniya gui) can write it for you.
#
# The default council runs through command-line tools you are already logged into and needs no key
# except DeepSeek. Keep these commented out until you have a real value: a line with an empty value
# would override the same variable from your shell.
#
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
