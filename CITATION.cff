    given-names: Muhammadjon
license: Apache-2.0
repository-code: "https://github.com/S2Lobby/karamaniya-research"
version: "engine-5"
date-released: "2026-10-06"
keywords:
  - multi-agent systems
  - AI evaluation
  - long-horizon behavior
  - language-model agents
  - evaluation reliability
