# Large or binary trajectory outputs. The small JSON files (metrics_history.json, summary.json,
# parity_check.json) are kept; the DuckDB store and its parquet copies are regenerated by run.py.
trajectory/**/*.duckdb
trajectory/**/*.parquet
# The legacy run folders (checkpoint, logs, report.html). Regenerated by run.py.
trajectory/**/wrapped_run/
trajectory/**/legacy_run/
# SocioVerse2's live heartbeat files: progress.jsonl carries wall-clock times, so it differs between runs.
trajectory/**/progress.jsonl
trajectory/**/panel_live.jsonl
